<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#B2E482"
    tools:context=".MainActivity">
    <!--
    każdy element musi mieć zdefiniowaną wysokość i szerokość
    może być konkretnie dp
    match_parent - dopasuj do rozmiaru elementu nadrzędnego
    bierzemy całą szerokośćlub wysokość rodzica
    wrap_content - dopasuj do zawartości, bierzemy tyle ile trzeba żeby się zmieściło
    rozmiar czcionki sp
    -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wybierz kolory, których nie ma we fladze Polski."
        android:textSize="24sp"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:background="#1B6B22"
        android:textColor="#cfd512"
        android:textAlignment="center"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/white"
            android:layout_margin="8dp"
            android:onClick="wybierzKolorOk"
             />

        <Button
            android:id="@+id/button2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#66d526"
            android:layout_margin="8dp" />

        <Button
            android:id="@+id/button3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#ffd526"
            android:layout_margin="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#66d5FF"
            android:layout_margin="8dp" />

        <Button
            android:id="@+id/button5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#660026"
            android:layout_margin="8dp"/>

        <Button
            android:id="@+id/button6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#db1744"
            android:layout_margin="8dp"
            android:onClick="wybierzKolorOk"/>
    </LinearLayout>

</LinearLayout>